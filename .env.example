# Copiar a .env y ajustar. Nunca subir .env al repositorio.

LOG_LEVEL=INFO
# text (consola) o json (una línea JSON por registro, para herramientas de logs)
LOG_FORMAT=text
TIMEZONE=America/Argentina/Buenos_Aires

# Detección (yunet | mediapipe). El reconocimiento requiere yunet.
FACE_DETECTOR_BACKEND=yunet
DETECTION_MIN_CONFIDENCE=0.6
MAX_FACES=10

# Reconocimiento: distancia coseno máxima (SFace). Más bajo = más estricto.
FACE_RECOGNITION_THRESHOLD=0.63
MIN_FACE_SIZE=40
RECOGNITION_COOLDOWN_SECONDS=10

# Registro facial: calidad mínima de cada muestra (calibrado con tests/fixtures)
ENROLLMENT_MIN_FACE_SIZE=80
ENROLLMENT_MIN_DETECTION_SCORE=0.8
ENROLLMENT_MIN_SHARPNESS=100
ENROLLMENT_MIN_BRIGHTNESS=50
ENROLLMENT_MAX_BRIGHTNESS=210

# Liveness (prueba de vida básica por desafíos)
LIVENESS_TIMEOUT_SECONDS=20
LIVENESS_YAW_DEGREES=20
LIVENESS_PITCH_DEGREES=12
LIVENESS_BLINK_CLOSE_RATIO=0.65
LIVENESS_BLINK_OPEN_RATIO=0.85

# Asistencia: minutos mínimos entre dos registros de la misma persona.
ATTENDANCE_MIN_INTERVAL_MINUTES=10

# Cámara
CAMERA_INDEX=0
CAMERA_FPS=15
CAMERA_ID=default

# Privacidad. Guardar imágenes o vídeo no está soportado: SAVE_IMAGES y
# SAVE_VIDEO solo aceptan false (el arranque falla si se ponen en true).
SAVE_IMAGES=false
SAVE_VIDEO=false
SAVE_EVENTS=true

# Base de datos (docker compose up -d postgres expone el puerto 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/facetrack
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/facetrack_test

# Clave para cifrar embeddings (obligatoria). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde, los embeddings guardados quedan inutilizables (hay que re-registrar rostros).
EMBEDDING_ENCRYPTION_KEY=

# API
MAX_UPLOAD_MB=5
# Documentación interactiva en /api/docs. Vacío = activa en development, desactivada en production.
API_DOCS=
# Orígenes del frontend (separados por coma). También se usan para rechazar
# escrituras desde otros orígenes. No se admite '*'.
CORS_ORIGINS=http://localhost:5173

# Seguridad
# "production" exige SECRET_KEY de 32+ caracteres y envía la cookie solo por HTTPS.
ENVIRONMENT=development
# Firma de las sesiones. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si queda vacía o débil en desarrollo, se usa una clave aleatoria por proceso
# (las sesiones se pierden al reiniciar el backend).
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Docker Compose (opcional; ver README, sección Docker)
# Si se cambia la contraseña, actualizar también DATABASE_URL y TEST_DATABASE_URL.
# Ojo: PostgreSQL la toma solo al crear el volumen por primera vez.
# POSTGRES_PASSWORD=postgres
# FRONTEND_PORT=8080
# PUBLIC_ORIGIN=http://localhost:8080
# DOCKER_ENVIRONMENT=production

# HTTPS (perfil "https": docker compose --profile https up -d; ver README)
# Con HTTPS, PUBLIC_ORIGIN debe listar las direcciones https://… usadas, p. ej.:
# PUBLIC_ORIGIN=https://localhost,https://192.168.1.34
# FACETRACK_HOSTS=localhost, 192.168.1.34
# FACETRACK_TLS=internal
# FACETRACK_DEFAULT_SNI=192.168.1.34
# HTTP_PORT=80
# HTTPS_PORT=443
