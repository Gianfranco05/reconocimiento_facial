# HTTPS para FaceTrack (servicio opcional "https" de docker-compose).
#
# FACETRACK_HOSTS: direcciones con las que se abre la app, separadas por coma.
#   Ej.: "localhost, 192.168.1.34" o "facetrack.miempresa.com".
# FACETRACK_TLS:
#   internal         → certificados de una CA local de Caddy (red interna,
#                      IPs o nombres que no son dominios públicos). Hay que
#                      instalar su certificado raíz en cada dispositivo
#                      (ver README, sección HTTPS).
#   un email          → certificados de Let's Encrypt (requiere un dominio
#                      público que apunte a esta máquina y los puertos 80/443
#                      accesibles desde internet).
# FACETRACK_DEFAULT_SNI:
#   Certificado a usar cuando el cliente no indica el nombre del sitio en el
#   saludo TLS (SNI). Los navegadores no lo indican al entrar por IP, así que
#   si se usa la app por IP, poner acá esa IP.

{
	default_sni {$FACETRACK_DEFAULT_SNI:localhost}
}

{$FACETRACK_HOSTS:localhost} {
	tls {$FACETRACK_TLS:internal}

	encode zstd gzip

	# HTTPS obligatorio en adelante para este sitio (el navegador no vuelve a
	# intentar HTTP). max-age corto: 30 días.
	header Strict-Transport-Security "max-age=2592000"

	# nginx (frontend) sirve la aplicación y redirige /api al backend.
	reverse_proxy frontend:8080

	log {
		output stdout
		format console
	}
}
